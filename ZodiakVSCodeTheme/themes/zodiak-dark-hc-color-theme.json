  "semanticTokenColors": {
    "namespace": "#8ea6d5",
    "class": { "foreground": "#00d5d0" },
    "interface": { "foreground": "#00d5d0", "italic": true },
    "enum": { "foreground": "#ffa7a9" },
    "struct": { "foreground": "#00d5d0" },
    "type": { "foreground": "#00d5d0" },
    "typeParameter": { "foreground": "#00d5d0" },
    "function": { "foreground": "#8ea6d5" },
    "function.async": { "foreground": "#8ea6d5", "italic": true },
    "method": { "foreground": "#8ea6d5" },
    "macro": { "foreground": "#f9a464" },
    "variable": { "foreground": "#ffffff" },
    "variable.readonly": { "foreground": "#ffa7a9" },
    "parameter": { "foreground": "#dfe1eb" },
    "property": { "foreground": "#dfe1eb" },
    "enumMember": { "foreground": "#ffa7a9" },
    "decorator": { "foreground": "#f9a464", "italic": true },
    "comment": { "foreground": "#5685c6", "italic": true },
    "string": { "foreground": "#21b87d" },
    "keyword": { "foreground": "#f9a464" },
    "keyword.async": { "foreground": "#f9a464", "italic": true },
    "number": { "foreground": "#00d5d0" },
    "regexp": { "foreground": "#f9a464" },
    "operator": { "foreground": "#dfe1eb" },
    "*.deprecated": { "strikethrough": true },
    "*.abstract": { "italic": true }
  },

  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5685c6", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string", "string.quoted.double", "string.quoted.single", "string.template"], "settings": { "foreground": "#21b87d" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#00d5d0" } },
    { "name": "Language constants", "scope": ["constant.language"], "settings": { "foreground": "#ffa7a9" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#f9a464" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#dfe1eb" } },
    { "name": "Punctuation", "scope": ["punctuation"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#dfe1eb" } },
    { "name": "Types / Classes", "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#00d5d0" } },
    { "name": "Variables", "scope": ["variable", "variable.other"], "settings": { "foreground": "#ffffff" } },
    { "name": "HTML tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "HTML attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#00d5d0" } },
    { "name": "JSON keys", "scope": ["support.type.property-name.json"], "settings": { "foreground": "#00d5d0" } },
    { "name": "YAML keys", "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Markdown headings", "scope": ["markup.heading"], "settings": { "foreground": "#f9a464", "fontStyle": "bold" } },
    { "name": "Markdown links", "scope": ["markup.underline.link"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Swift — type declarations", "scope": ["entity.name.type.swift", "entity.name.class.swift"], "settings": { "foreground": "#00d5d0" } },
    { "name": "Swift — function/method names", "scope": ["entity.name.function.swift", "support.function.swift"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Swift — enum case declarations", "scope": ["entity.name.variable.case.swift", "entity.name.function.case.swift"], "settings": { "foreground": "#ffa7a9" } },
    { "name": "Swift — implicit member / dot expressions", "scope": ["variable.other.member.swift", "variable.other.enummember.swift"], "settings": { "foreground": "#ffa7a9" } },
    { "name": "Swift — variables & implicit members", "scope": ["variable.other.swift"], "settings": { "foreground": "#dfe1eb" } },
    { "name": "Swift — property names", "scope": ["variable.other.property.swift", "entity.name.variable.property.swift"], "settings": { "foreground": "#dfe1eb" } },
    { "name": "Swift — compiler directives", "scope": ["keyword.other.directive.swift", "keyword.control.directive.swift"], "settings": { "foreground": "#f9a464", "fontStyle": "italic" } },
    { "name": "Swift — attributes", "scope": ["storage.modifier.attribute.swift", "keyword.attributes.swift"], "settings": { "foreground": "#8ea6d5", "fontStyle": "italic" } },
    { "name": "Java/Kotlin — annotations", "scope": ["storage.type.annotation.java", "punctuation.definition.annotation.java", "entity.name.type.annotation.kt", "storage.type.annotation.kt"], "settings": { "foreground": "#f9a464", "fontStyle": "italic" } },
    { "name": "Java/Kotlin — type declarations", "scope": ["entity.name.type.class.java", "entity.name.type.interface.java", "entity.name.type.enum.java", "entity.name.type.class.kt", "entity.name.type.interface.kt", "entity.name.type.enum.kt", "entity.name.type.object.kt"], "settings": { "foreground": "#00d5d0" } },
    { "name": "Java/Kotlin — method names", "scope": ["entity.name.function.java", "entity.name.function.kt"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Java/Kotlin — constants", "scope": ["variable.other.constant.java", "variable.other.object.constant.kt"], "settings": { "foreground": "#ffa7a9" } },
    { "name": "Kotlin — var/val/fun keywords", "scope": ["storage.type.var.kotlin", "keyword.other.val.kotlin", "keyword.other.var.kotlin", "keyword.other.fun.kotlin"], "settings": { "foreground": "#f9a464" } },
    { "name": "Kotlin — string templates", "scope": ["variable.template-expression.kotlin", "punctuation.definition.template-expression.begin.kotlin", "punctuation.definition.template-expression.end.kotlin"], "settings": { "foreground": "#00d5d0" } },
    { "name": "Kotlin — modifiers", "scope": ["storage.type.class.kotlin", "storage.modifier.kotlin"], "settings": { "foreground": "#f9a464" } }
  ]
}
