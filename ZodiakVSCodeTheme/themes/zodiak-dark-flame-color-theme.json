  "semanticTokenColors": {
    "namespace": "#8ea6d5",
    "class": { "foreground": "#f9a464" },
    "class.declaration": { "foreground": "#f9a464", "bold": true },
    "interface": { "foreground": "#ffeabd", "italic": true },
    "enum": { "foreground": "#ffa7a9" },
    "struct": { "foreground": "#f9a464" },
    "type": { "foreground": "#f9a464" },
    "typeParameter": { "foreground": "#ffeabd", "italic": true },
    "function": { "foreground": "#5685c6" },
    "function.async": { "foreground": "#5685c6", "italic": true },
    "method": { "foreground": "#5685c6" },
    "macro": { "foreground": "#ffeabd" },
    "variable": { "foreground": "#f1f4f7" },
    "variable.readonly": { "foreground": "#ffa7a9" },
    "parameter": { "foreground": "#e9edf3" },
    "property": { "foreground": "#c7ccd3" },
    "enumMember": { "foreground": "#ffa7a9" },
    "decorator": { "foreground": "#ffeabd", "italic": true },
    "comment": { "foreground": "#595e6a", "italic": true },
    "string": { "foreground": "#21b87d" },
    "keyword": { "foreground": "#f68f40" },
    "keyword.async": { "foreground": "#f68f40", "italic": true },
    "number": { "foreground": "#f9a464" },
    "regexp": { "foreground": "#ffeabd" },
    "operator": { "foreground": "#c7ccd3" },
    "*.deprecated": { "strikethrough": true },
    "*.async": { "italic": true }
  },

  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#595e6a", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string", "string.quoted.double", "string.quoted.single", "string.template"], "settings": { "foreground": "#21b87d" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#f9a464" } },
    { "name": "Language constants", "scope": ["constant.language"], "settings": { "foreground": "#ffa7a9" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#f68f40" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#c7ccd3" } },
    { "name": "Punctuation", "scope": ["punctuation"], "settings": { "foreground": "#888f9a" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#5685c6" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#e9edf3" } },
    { "name": "Types / Classes", "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.name.namespace"], "settings": { "foreground": "#f9a464" } },
    { "name": "Decorators", "scope": ["meta.decorator", "storage.type.annotation"], "settings": { "foreground": "#ffeabd", "fontStyle": "italic" } },
    { "name": "Variables", "scope": ["variable", "variable.other"], "settings": { "foreground": "#f1f4f7" } },
    { "name": "this/self", "scope": ["variable.language.this", "variable.language.self"], "settings": { "foreground": "#ffa7a9", "fontStyle": "italic" } },
    { "name": "Properties", "scope": ["variable.other.property"], "settings": { "foreground": "#c7ccd3" } },
    { "name": "HTML tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#5685c6" } },
    { "name": "HTML attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f9a464" } },
    { "name": "CSS properties", "scope": ["support.type.property-name.css", "support.type.property-name"], "settings": { "foreground": "#f9a464" } },
    { "name": "CSS selectors", "scope": ["meta.selector", "entity.name.tag.css"], "settings": { "foreground": "#f68f40" } },
    { "name": "JSON keys", "scope": ["support.type.property-name.json"], "settings": { "foreground": "#f9a464" } },
    { "name": "YAML keys", "scope": ["entity.name.tag.yaml", "string.unquoted.plain.in.yaml"], "settings": { "foreground": "#f68f40" } },
    { "name": "Markdown headings", "scope": ["markup.heading"], "settings": { "foreground": "#ffeabd", "fontStyle": "bold" } },
    { "name": "Markdown links", "scope": ["markup.underline.link"], "settings": { "foreground": "#5685c6" } },
    { "name": "Markdown code", "scope": ["markup.inline.raw.string.markdown", "markup.raw.block"], "settings": { "foreground": "#21b87d" } },
    { "name": "Swift — type declarations", "scope": ["entity.name.type.swift", "entity.name.class.swift"], "settings": { "foreground": "#00d5d0" } },
    { "name": "Swift — function/method names", "scope": ["entity.name.function.swift", "support.function.swift"], "settings": { "foreground": "#5685c6" } },
    { "name": "Swift — enum case declarations", "scope": ["entity.name.variable.case.swift", "entity.name.function.case.swift"], "settings": { "foreground": "#ffa7a9" } },
    { "name": "Swift — implicit member / dot expressions", "scope": ["variable.other.member.swift", "variable.other.enummember.swift"], "settings": { "foreground": "#ffa7a9" } },
    { "name": "Swift — variables & implicit members", "scope": ["variable.other.swift"], "settings": { "foreground": "#ffeabd" } },
    { "name": "Swift — property names", "scope": ["variable.other.property.swift", "entity.name.variable.property.swift"], "settings": { "foreground": "#ffeabd" } },
    { "name": "Swift — compiler directives", "scope": ["keyword.other.directive.swift", "keyword.control.directive.swift"], "settings": { "foreground": "#f9a464", "fontStyle": "italic" } },
    { "name": "Swift — attributes", "scope": ["storage.modifier.attribute.swift", "keyword.attributes.swift"], "settings": { "foreground": "#ffeabd", "fontStyle": "italic" } },
    { "name": "Java/Kotlin — annotations", "scope": ["storage.type.annotation.java", "punctuation.definition.annotation.java", "entity.name.type.annotation.kt", "storage.type.annotation.kt"], "settings": { "foreground": "#f9a464", "fontStyle": "italic" } },
    { "name": "Java/Kotlin — type declarations", "scope": ["entity.name.type.class.java", "entity.name.type.interface.java", "entity.name.type.enum.java", "entity.name.type.class.kt", "entity.name.type.interface.kt", "entity.name.type.enum.kt", "entity.name.type.object.kt"], "settings": { "foreground": "#00d5d0" } },
    { "name": "Java/Kotlin — method names", "scope": ["entity.name.function.java", "entity.name.function.kt"], "settings": { "foreground": "#5685c6" } },
    { "name": "Java/Kotlin — constants", "scope": ["variable.other.constant.java", "variable.other.object.constant.kt"], "settings": { "foreground": "#ffa7a9" } },
    { "name": "Kotlin — var/val/fun keywords", "scope": ["storage.type.var.kotlin", "keyword.other.val.kotlin", "keyword.other.var.kotlin", "keyword.other.fun.kotlin"], "settings": { "foreground": "#f9a464" } },
    { "name": "Kotlin — string templates", "scope": ["variable.template-expression.kotlin", "punctuation.definition.template-expression.begin.kotlin", "punctuation.definition.template-expression.end.kotlin"], "settings": { "foreground": "#ffeabd" } },
    { "name": "Kotlin — modifiers", "scope": ["storage.type.class.kotlin", "storage.modifier.kotlin"], "settings": { "foreground": "#f9a464" } }
  ]
}
