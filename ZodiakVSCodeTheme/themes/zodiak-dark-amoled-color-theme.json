  "semanticTokenColors": {
    "namespace": "#8ea6d5",
    "namespace.declaration": { "foreground": "#8ea6d5", "bold": true },
    "class": { "foreground": "#00d5d0" },
    "class.declaration": { "foreground": "#00d5d0", "bold": true },
    "enum": { "foreground": "#ffa7a9" },
    "interface": { "foreground": "#00d5d0", "italic": true },
    "struct": { "foreground": "#00d5d0" },
    "typeParameter": { "foreground": "#00d5d0", "italic": true },
    "type": { "foreground": "#00d5d0" },
    "function": { "foreground": "#5685c6" },
    "function.async": { "foreground": "#5685c6", "italic": true },
    "method": { "foreground": "#5685c6" },
    "method.async": { "foreground": "#5685c6", "italic": true },
    "macro": { "foreground": "#f9a464" },
    "variable": { "foreground": "#f1f4f7" },
    "variable.readonly": { "foreground": "#ffa7a9" },
    "variable.defaultLibrary": { "foreground": "#ffa7a9" },
    "parameter": { "foreground": "#e9edf3" },
    "property": { "foreground": "#c7ccd3" },
    "property.readonly": { "foreground": "#ffa7a9" },
    "enumMember": { "foreground": "#ffa7a9" },
    "decorator": { "foreground": "#f9a464", "italic": true },
    "event": { "foreground": "#00d5d0" },
    "comment": { "foreground": "#474c56", "italic": true },
    "string": { "foreground": "#21b87d" },
    "keyword": { "foreground": "#f9a464" },
    "keyword.async": { "foreground": "#f9a464", "italic": true },
    "number": { "foreground": "#00d5d0" },
    "regexp": { "foreground": "#f9a464" },
    "operator": { "foreground": "#c7ccd3" },
    "*.deprecated": { "strikethrough": true },
    "*.abstract": { "italic": true },
    "*.async": { "italic": true }
  },

  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#474c56", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string", "string.quoted.double", "string.quoted.single", "string.quoted.backtick", "string.template"], "settings": { "foreground": "#21b87d" } },
