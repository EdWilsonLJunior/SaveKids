  "semanticTokenColors": {
    "namespace": "#1c4076",
    "class": { "foreground": "#29656f" },
    "interface": { "foreground": "#29656f", "italic": true },
    "enum": { "foreground": "#9e0029" },
    "struct": { "foreground": "#29656f" },
    "type": { "foreground": "#29656f" },
    "typeParameter": { "foreground": "#29656f", "italic": true },
    "function": { "foreground": "#0058ab" },
    "function.async": { "foreground": "#0058ab", "italic": true },
    "method": { "foreground": "#0058ab" },
    "macro": { "foreground": "#cc640f" },
    "variable": { "foreground": "#171a22" },
    "variable.readonly": { "foreground": "#9e0029" },
    "parameter": { "foreground": "#343840" },
    "property": { "foreground": "#474c56" },
    "enumMember": { "foreground": "#9e0029" },
    "decorator": { "foreground": "#cc640f", "italic": true },
    "comment": { "foreground": "#888f9a", "italic": true },
    "string": { "foreground": "#1e5631" },
    "keyword": { "foreground": "#1d365a" },
    "keyword.async": { "foreground": "#1d365a", "italic": true },
    "number": { "foreground": "#29656f" },
    "regexp": { "foreground": "#cc640f" },
    "operator": { "foreground": "#595e6a" },
    "*.deprecated": { "strikethrough": true },
    "*.async": { "italic": true }
  },

  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#888f9a", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string", "string.quoted.double", "string.quoted.single", "string.template"], "settings": { "foreground": "#1e5631" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#29656f" } },
    { "name": "Language constants", "scope": ["constant.language"], "settings": { "foreground": "#9e0029" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#1d365a" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#595e6a" } },
    { "name": "Punctuation", "scope": ["punctuation"], "settings": { "foreground": "#a6acb5" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#0058ab" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#474c56" } },
    { "name": "Types / Classes", "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.name.namespace"], "settings": { "foreground": "#29656f" } },
    { "name": "Decorators", "scope": ["meta.decorator", "storage.type.annotation", "entity.name.function.decorator"], "settings": { "foreground": "#cc640f", "fontStyle": "italic" } },
    { "name": "Variables", "scope": ["variable", "variable.other"], "settings": { "foreground": "#171a22" } },
    { "name": "this/self", "scope": ["variable.language.this", "variable.language.self", "variable.language.super"], "settings": { "foreground": "#9e0029", "fontStyle": "italic" } },
    { "name": "Properties", "scope": ["variable.other.property", "variable.other.object.property"], "settings": { "foreground": "#474c56" } },
    { "name": "HTML tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#0058ab" } },
    { "name": "HTML attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#29656f" } },
    { "name": "CSS properties", "scope": ["support.type.property-name.css", "support.type.property-name"], "settings": { "foreground": "#29656f" } },
    { "name": "CSS selectors", "scope": ["meta.selector", "entity.name.tag.css"], "settings": { "foreground": "#1c4076" } },
    { "name": "JSON keys", "scope": ["support.type.property-name.json"], "settings": { "foreground": "#29656f" } },
    { "name": "YAML keys", "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#1c4076" } },
    { "name": "Markdown headings", "scope": ["markup.heading"], "settings": { "foreground": "#1d365a", "fontStyle": "bold" } },
    { "name": "Markdown links", "scope": ["markup.underline.link"], "settings": { "foreground": "#0058ab" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#9e0029", "fontStyle": "underline" } },
    { "name": "Swift — type declarations", "scope": ["entity.name.type.swift", "entity.name.class.swift"], "settings": { "foreground": "#29656f" } },
    { "name": "Swift — function/method names", "scope": ["entity.name.function.swift", "support.function.swift"], "settings": { "foreground": "#0058ab" } },
    { "name": "Swift — enum case declarations", "scope": ["entity.name.variable.case.swift", "entity.name.function.case.swift"], "settings": { "foreground": "#9e0029" } },
    { "name": "Swift — implicit member / dot expressions", "scope": ["variable.other.member.swift", "variable.other.enummember.swift"], "settings": { "foreground": "#9e0029" } },
    { "name": "Swift — variables & implicit members", "scope": ["variable.other.swift"], "settings": { "foreground": "#474c56" } },
    { "name": "Swift — property names", "scope": ["variable.other.property.swift", "entity.name.variable.property.swift"], "settings": { "foreground": "#474c56" } },
    { "name": "Swift — compiler directives", "scope": ["keyword.other.directive.swift", "keyword.control.directive.swift"], "settings": { "foreground": "#cc640f", "fontStyle": "italic" } },
    { "name": "Swift — attributes", "scope": ["storage.modifier.attribute.swift", "keyword.attributes.swift"], "settings": { "foreground": "#cc640f", "fontStyle": "italic" } },
    { "name": "Java/Kotlin — annotations", "scope": ["storage.type.annotation.java", "punctuation.definition.annotation.java", "entity.name.type.annotation.kt", "storage.type.annotation.kt"], "settings": { "foreground": "#cc640f", "fontStyle": "italic" } },
    { "name": "Java/Kotlin — type declarations", "scope": ["entity.name.type.class.java", "entity.name.type.interface.java", "entity.name.type.enum.java", "entity.name.type.class.kt", "entity.name.type.interface.kt", "entity.name.type.enum.kt", "entity.name.type.object.kt"], "settings": { "foreground": "#29656f" } },
    { "name": "Java/Kotlin — method names", "scope": ["entity.name.function.java", "entity.name.function.kt"], "settings": { "foreground": "#0058ab" } },
    { "name": "Java/Kotlin — constants", "scope": ["variable.other.constant.java", "variable.other.object.constant.kt"], "settings": { "foreground": "#9e0029" } },
    { "name": "Kotlin — var/val/fun keywords", "scope": ["storage.type.var.kotlin", "keyword.other.val.kotlin", "keyword.other.var.kotlin", "keyword.other.fun.kotlin"], "settings": { "foreground": "#cc640f" } },
    { "name": "Kotlin — string templates", "scope": ["variable.template-expression.kotlin", "punctuation.definition.template-expression.begin.kotlin", "punctuation.definition.template-expression.end.kotlin"], "settings": { "foreground": "#29656f" } },
    { "name": "Kotlin — modifiers", "scope": ["storage.type.class.kotlin", "storage.modifier.kotlin"], "settings": { "foreground": "#cc640f" } }
  ]
}
