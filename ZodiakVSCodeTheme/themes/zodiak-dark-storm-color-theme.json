  "semanticTokenColors": {
    "namespace": "#a6acb5",
    "class": { "foreground": "#8ea6d5" },
    "interface": { "foreground": "#8ea6d5", "italic": true },
    "enum": { "foreground": "#c7ccd3" },
    "struct": { "foreground": "#8ea6d5" },
    "type": { "foreground": "#8ea6d5" },
    "typeParameter": { "foreground": "#8ea6d5", "italic": true },
    "function": { "foreground": "#5685c6" },
    "function.async": { "foreground": "#5685c6", "italic": true },
    "method": { "foreground": "#5685c6" },
    "macro": { "foreground": "#c7ccd3" },
    "variable": { "foreground": "#c7ccd3" },
    "variable.readonly": { "foreground": "#a6acb5" },
    "parameter": { "foreground": "#d9dde3" },
    "property": { "foreground": "#888f9a" },
    "enumMember": { "foreground": "#a6acb5" },
    "decorator": { "foreground": "#c7ccd3", "italic": true },
    "comment": { "foreground": "#474c56", "italic": true },
    "string": { "foreground": "#21b87d" },
    "keyword": { "foreground": "#8ea6d5" },
    "keyword.async": { "foreground": "#8ea6d5", "italic": true },
    "number": { "foreground": "#5685c6" },
    "regexp": { "foreground": "#c7ccd3" },
    "operator": { "foreground": "#888f9a" },
    "*.deprecated": { "strikethrough": true },
    "*.async": { "italic": true }
  },

  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#474c56", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string", "string.quoted.double", "string.quoted.single", "string.template"], "settings": { "foreground": "#21b87d" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#5685c6" } },
    { "name": "Language constants", "scope": ["constant.language"], "settings": { "foreground": "#a6acb5" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#888f9a" } },
    { "name": "Punctuation", "scope": ["punctuation"], "settings": { "foreground": "#595e6a" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#5685c6" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#d9dde3" } },
    { "name": "Types / Classes", "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.name.namespace"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Variables", "scope": ["variable", "variable.other"], "settings": { "foreground": "#c7ccd3" } },
    { "name": "Properties", "scope": ["variable.other.property"], "settings": { "foreground": "#888f9a" } },
    { "name": "HTML tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#5685c6" } },
    { "name": "HTML attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "CSS properties", "scope": ["support.type.property-name.css", "support.type.property-name"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "CSS selectors", "scope": ["meta.selector", "entity.name.tag.css"], "settings": { "foreground": "#a6acb5" } },
    { "name": "JSON keys", "scope": ["support.type.property-name.json"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "YAML keys", "scope": ["entity.name.tag.yaml", "string.unquoted.plain.in.yaml"], "settings": { "foreground": "#a6acb5" } },
    { "name": "Markdown headings", "scope": ["markup.heading"], "settings": { "foreground": "#c7ccd3", "fontStyle": "bold" } },
    { "name": "Markdown links", "scope": ["markup.underline.link"], "settings": { "foreground": "#5685c6" } },
    { "name": "Swift — type declarations", "scope": ["entity.name.type.swift", "entity.name.class.swift"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Swift — function/method names", "scope": ["entity.name.function.swift", "support.function.swift"], "settings": { "foreground": "#5685c6" } },
    { "name": "Swift — enum case declarations", "scope": ["entity.name.variable.case.swift", "entity.name.function.case.swift"], "settings": { "foreground": "#a6acb5" } },
    { "name": "Swift — implicit member / dot expressions", "scope": ["variable.other.member.swift", "variable.other.enummember.swift"], "settings": { "foreground": "#a6acb5" } },
    { "name": "Swift — variables & implicit members", "scope": ["variable.other.swift"], "settings": { "foreground": "#888f9a" } },
    { "name": "Swift — property names", "scope": ["variable.other.property.swift", "entity.name.variable.property.swift"], "settings": { "foreground": "#888f9a" } },
    { "name": "Swift — compiler directives", "scope": ["keyword.other.directive.swift", "keyword.control.directive.swift"], "settings": { "foreground": "#8ea6d5", "fontStyle": "italic" } },
    { "name": "Swift — attributes", "scope": ["storage.modifier.attribute.swift", "keyword.attributes.swift"], "settings": { "foreground": "#a6acb5", "fontStyle": "italic" } },
    { "name": "Java/Kotlin — annotations", "scope": ["storage.type.annotation.java", "punctuation.definition.annotation.java", "entity.name.type.annotation.kt", "storage.type.annotation.kt"], "settings": { "foreground": "#a6acb5", "fontStyle": "italic" } },
    { "name": "Java/Kotlin — type declarations", "scope": ["entity.name.type.class.java", "entity.name.type.interface.java", "entity.name.type.enum.java", "entity.name.type.class.kt", "entity.name.type.interface.kt", "entity.name.type.enum.kt", "entity.name.type.object.kt"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Java/Kotlin — method names", "scope": ["entity.name.function.java", "entity.name.function.kt"], "settings": { "foreground": "#5685c6" } },
    { "name": "Java/Kotlin — constants", "scope": ["variable.other.constant.java", "variable.other.object.constant.kt"], "settings": { "foreground": "#a6acb5" } },
    { "name": "Kotlin — var/val/fun keywords", "scope": ["storage.type.var.kotlin", "keyword.other.val.kotlin", "keyword.other.var.kotlin", "keyword.other.fun.kotlin"], "settings": { "foreground": "#8ea6d5" } },
    { "name": "Kotlin — string templates", "scope": ["variable.template-expression.kotlin", "punctuation.definition.template-expression.begin.kotlin", "punctuation.definition.template-expression.end.kotlin"], "settings": { "foreground": "#5685c6" } },
    { "name": "Kotlin — modifiers", "scope": ["storage.type.class.kotlin", "storage.modifier.kotlin"], "settings": { "foreground": "#8ea6d5" } }
  ]
}
