    "catalog.color.token_count_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semantic tokens organized by role — brand, surfaces, text, status, actions, borders and overlays — plus primitive color ramps with light/dark adaptive values."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens semânticos organizados por papel — marca, superfícies, texto, status, ações, bordas e overlays — além das rampas de cor primitivas com valores adaptativos light/dark."
          }
        }
      }
    },
    "catalog.color.tooltip_adaptive" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
