    "catalog.switch.guideline.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a switch when the action takes effect immediately, without a confirmation step. Both the switch element and its label should respond to tap."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use um switch quando a ação entra em vigor imediatamente, sem etapa de confirmação. Tanto o elemento switch quanto o seu label devem responder ao toque."
          }
        }
      }
    },
