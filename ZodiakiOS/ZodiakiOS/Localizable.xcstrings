        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça"
          }
        }
      }
    },
    "catalog.alert.guidelines.dont_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not use Alert for persistent or structural information — use Notice or InfoRow instead."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não use Alert para informações persistentes ou estruturais — use Notice ou InfoRow."
          }
        }
      }
    },
    "catalog.alert.guidelines.dont_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid stacking multiple alerts — show only the most critical one."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite empilhar múltiplos alerts — mostre apenas o mais crítico."
          }
        }
      }
    },
    "catalog.alert.guidelines.dont_example_msg" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The system encountered an unexpected condition that prevented the request from completing. Please check your connection, verify your credentials, and try again later."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema encontrou uma condição inesperada que impediu a conclusão da solicitação. Verifique sua conexão, suas credenciais e tente novamente mais tarde."
          }
        }
      }
    },
