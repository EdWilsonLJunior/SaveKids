    "catalog.texts.desc.alignment" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`alignment:` and `lineLimit:` are passed directly in the initializer. Leading is the default."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`alignment:` e `lineLimit:` são passados diretamente no inicializador. O padrão é `.leading`."
          }
        }
      }
    },
    "catalog.texts.desc.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reading and UI text. Pass `bold: true` for inline emphasis. Color is configurable via `ZodiakTextColor`."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textos de leitura e interface. Use `bold: true` para ênfase pontual. Cor configurável via `ZodiakTextColor`."
          }
        }
      }
    },
    "catalog.texts.desc.colors" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color is a `ZodiakTextColor` case passed in the style init: `.body(color: .secondary)`. Adapts to dark mode automatically."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor é um case de `ZodiakTextColor` passado no init do estilo: `.body(color: .secondary)`. Adapta-se ao dark mode automaticamente."
          }
        }
      }
    },
    "catalog.texts.desc.display" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editorial headings (128–40 pt, Light 300). Use sparingly — 1 per screen max. Pass `.weight(.regular)` for the firmer variant."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Headings editoriais (128–40 pt, Light 300). Use com moderação — no máximo 1 por tela. Use `.weight(.regular)` para a variante mais firme."
          }
        }
      }
    },
    "catalog.texts.desc.italic" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decorative — use for quotes and editorial callouts. Avoid for emphasis inside paragraphs."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso decorativo — citações e destaques editoriais. Não usar para ênfase em parágrafos."
          }
        }
      }
    },
    "catalog.texts.desc.playground" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type below to preview all ZodiakText styles live."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite abaixo para pré-visualizar todos os estilos ZodiakText em tempo real."
          }
        }
      }
    },
    "catalog.texts.desc.standard" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General-purpose titles for screens and cards. Color fixed at `textPrimary` — not configurable."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Títulos de uso geral em telas e cards. Cor fixa em `textPrimary` — não configurável."
          }
        }
      }
