    "catalog.accordion.faq.a1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Accordion when content is optional or secondary. Tabs work better for top-level navigation between equal-weight sections."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Accordion quando o conteúdo é opcional ou secundário. Tabs funcionam melhor para navegação entre seções de peso igual."
          }
        }
      }
    },
    "catalog.accordion.faq.a2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesting is possible but discouraged. It adds visual depth and cognitive load. Prefer a flat ZodiakAccordionGroup with descriptive titles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aninhamento é possível, mas não recomendado. Adiciona profundidade visual e carga cognitiva. Prefira um ZodiakAccordionGroup plano com títulos descritivos."
          }
        }
      }
    },
    "catalog.accordion.faq.a3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each item in ZodiakAccordionGroup is independent. Expanding one does not collapse others. Use it for FAQs, settings groups, or feature breakdowns."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada item no ZodiakAccordionGroup é independente. Expandir um não colapsa os outros. Use-o para FAQs, grupos de configuração ou detalhamentos de funcionalidades."
          }
        }
      }
    },
