    "catalog.texts.a11y.header_trait_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All heading styles automatically apply the .isHeader accessibility trait. VoiceOver announces the text as a heading, enabling heading navigation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os styles de heading aplicam automaticamente o trait .isHeader. O VoiceOver anuncia o texto como cabeçalho, habilitando navegação por headings."
          }
        }
      }
    },
    "catalog.texts.a11y.header_trait_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use .title2 or above for section titles; use .body() for regular paragraph text."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use .title2 ou superior para títulos de seção; use .body() para parágrafo comum."
          }
        }
      }
    },
    "catalog.texts.a11y.header_trait_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "isHeader Trait"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trait isHeader"
          }
        }
      }
    },
    "catalog.texts.a11y.verbatim_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZodiakText(\"key\", style:) treats the string as a localization key. ZodiakText(verbatim: string, style:) displays the literal value — correct for dynamic data."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZodiakText(\"key\", style:) trata a string como chave de localização. ZodiakText(verbatim: string, style:) exibe o valor literal — correto para dados dinâmicos."
          }
        }
      }
    },
    "catalog.texts.a11y.verbatim_dynamic_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displayed without lookup. Use for user data or generated content."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibido sem lookup. Use para dados do usuário ou conteúdo gerado."
          }
        }
      }
    },
    "catalog.texts.a11y.verbatim_key_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Key is resolved from the bundle. Use for UI text that needs translation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave é resolvida no bundle. Use para textos de UI que precisam de tradução."
          }
        }
      }
    },
