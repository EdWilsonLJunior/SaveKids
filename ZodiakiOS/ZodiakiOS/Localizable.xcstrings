    "contacts.info.wizard.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "canProceed is a property of the step model — the DS component knows nothing about business logic. The feature passes isStep1Valid via binding. On save, the progress bar animates to 100% (textPositive color), the icon bounces with spring and onComplete() is called after 1.4s."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "canProceed é uma propriedade do modelo de step — o componente DS não sabe nada da lógica de negócio. A feature passa isStep1Valid via binding. Ao salvar, a progress bar anima para 100% (cor textPositive), o ícone faz bounce com spring e onComplete() é chamado após 1.4s."
          }
        }
      }
    },
