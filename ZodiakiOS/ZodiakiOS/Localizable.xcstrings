    "catalog.composition.faq.adaptive_ans" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. Compositions use available width, flexible grids, and stacked versions when space is reduced."
          }
