    "catalog.alert.guidelines.do_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use for transient feedback directly related to a user action."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use para feedback transitório diretamente relacionado a uma ação do usuário."
          }
        }
      }
    },
    "catalog.alert.guidelines.do_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep messages short and actionable — one sentence max."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha mensagens curtas e acionáveis — máximo uma frase."
          }
        }
      }
    },
    "catalog.alert.guidelines.do_title" : {
      "extractionState" : "manual",
      "localizations" : {
