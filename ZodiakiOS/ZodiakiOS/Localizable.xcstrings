    "contacts.info.localization.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ViewModels expose semantic types (ValidationError, LocalizedStringKey) and never resolve strings directly. String(localized:) is used for dynamic strings passed as String. LocalizedStringKey is used in modifiers and DS components."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ViewModels expõem tipos semânticos (ValidationError, LocalizedStringKey) e nunca resolvem strings diretamente. String(localized:) é usado para strings dinâmicas passadas como String. LocalizedStringKey é usado em modificadores e componentes DS."
          }
        }
      }
    },
