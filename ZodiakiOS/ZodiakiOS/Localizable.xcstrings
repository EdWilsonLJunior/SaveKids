    "catalog.texts.a11y.color_contrast_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each semantic color token is calibrated to meet WCAG AA (4.5:1 for normal text, 3:1 for large text) in both light and dark themes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada token semântico de cor é calibrado para atender WCAG AA (4.5:1 para texto normal, 3:1 para texto grande) nos temas claro e escuro."
          }
        }
      }
    },
    "catalog.texts.a11y.color_contrast_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color Contrast"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraste de Cor"
          }
        }
      }
    },
    "catalog.texts.a11y.contrast_disabled_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decorative — don't carry critical content"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decorativo — não use para conteúdo crítico"
          }
        }
      }
    },
    "catalog.texts.a11y.dynamic_type_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZodiakText uses .custom(_:size:relativeTo:) — all styles scale with the system font size. Large headings (6XL–XL) use .largeTitle as their Dynamic Type anchor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZodiakText usa .custom(_:size:relativeTo:) — todos os styles escalam com o tamanho de fonte do sistema. Headings grandes (6XL–XL) usam .largeTitle como âncora de Dynamic Type."
          }
        }
      }
    },
    "catalog.texts.a11y.dynamic_type_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To clamp editorial displays on small screens, apply .dynamicTypeSize(...) on the parent container."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para clampar displays editoriais em telas pequenas, aplique .dynamicTypeSize(...) no container pai."
          }
        }
      }
    },
    "catalog.texts.a11y.dynamic_type_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamic Type"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamic Type"
          }
        }
      }
    },
