    "hig.accessibility_contrast.excerpt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provide enough contrast between text and its background to keep content legible. A minimum ratio of 4.5:1 is recommended for normal text (WCAG AA)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garanta contraste suficiente entre o texto e o fundo para manter o conteúdo legível. Uma proporção mínima de 4.5:1 é recomendada para texto normal (WCAG AA)."
          }
        }
      }
    },
    "hig.accessibility_contrast.section" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility — Color and Contrast"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acessibilidade — Cor e Contraste"
          }
        }
      }
    },
    "hig.color.excerpt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use color to enhance your interface and communicate status. Always pair color with another indicator so people who are color-blind get the same information."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use cores para enriquecer sua interface e comunicar estados. Sempre combine cor com outro indicador para que pessoas com daltonismo obtenham as mesmas informações."
          }
        }
      }
    },
    "hig.color.section" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor"
          }
        }
      }
    },
    "hig.dark_mode.excerpt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefer dynamic semantic colors that automatically adapt to Dark Mode. Avoid hardcoded color values that look good in one appearance but fail in another."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefira cores semânticas dinâmicas que se adaptam automaticamente ao Modo Escuro. Evite valores de cor fixos que parecem bons em uma aparência mas falham em outra."
          }
        }
      }
    },
    "hig.dark_mode.section" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark Mode"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo Escuro"
          }
        }
      }
    },
    "hig.inclusive_color.excerpt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't rely solely on color to communicate important information. Always pair color with a text label or symbol so that people who are color-blind can understand your UI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não dependa apenas de cor para comunicar informações importantes. Sempre combine cor com um rótulo ou símbolo para que pessoas com daltonismo possam compreender sua UI."
          }
        }
      }
    },
    "hig.inclusive_color.section" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color — Inclusive color"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor — Cor inclusiva"
          }
        }
      }
    },
    "hig.interactive_color.excerpt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a single consistent color for interactive elements to establish clear affordance. People associate that color with tappable, so inconsistent use creates confusion."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma cor consistente para elementos interativos para estabelecer uma affordance clara. As pessoas associam essa cor ao tocável, portanto o uso inconsistente cria confusão."
          }
        }
      }
    },
    "hig.interactive_color.section" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color — Interactive elements"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor — Elementos interativos"
          }
        }
      }
    },
    "hig.materials.excerpt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use materials and semantic colors to communicate hierarchy, depth, and vibrancy. Semantic surfaces automatically provide the right appearance in both Light and Dark Mode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use materiais e cores semânticas para comunicar hierarquia, profundidade e vivacidade. Superfícies semânticas fornecem automaticamente a aparência correta no Modo Claro e Escuro."
          }
        }
      }
    },
    "hig.materials.section" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Materials"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Materiais"
          }
        }
      }
    },
