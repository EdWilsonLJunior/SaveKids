    "catalog.layout_grid.nomenclature_disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠︎ ZodiakLayoutGrid uses horizontalSpacing / verticalSpacing to match SwiftUI's Grid API. However, the Zodiak Design System — platform-agnostic — defines this space as gutter (between columns) and margin (between screen edge and content). Zodiak is the single source of truth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠︎ ZodiakLayoutGrid usa horizontalSpacing / verticalSpacing para seguir a API do SwiftUI Grid. Porém o Zodiak Design System — agnóstico de plataforma — define este espaço como gutter (entre colunas) e margin (entre a borda da tela e o conteúdo). O Zodiak é a fonte única de verdade."
          }
        }
      }
    },
    "catalog.layout_grid.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
