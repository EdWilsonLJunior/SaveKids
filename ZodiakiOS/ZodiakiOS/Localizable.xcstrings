    "catalog.accordion.about_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodiak DS is Capgemini's official design system. It provides a set of components, design tokens and guidelines to create consistent and accessible digital experiences."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zodiak DS é o sistema de design oficial da Capgemini. Ele fornece um conjunto de componentes, tokens de design e diretrizes para criar experiências digitais consistentes e acessíveis."
          }
        }
      }
    },
