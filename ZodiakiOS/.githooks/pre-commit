#!/usr/bin/env bash
# .githooks/pre-commit — lint check + audit antes de cada commit
# Instale via: git config core.hooksPath .githooks
#              chmod +x .githooks/pre-commit
set -e

cd "$(git rev-parse --show-toplevel)"

# 1. SwiftLint nos arquivos staged
if command -v swiftlint >/dev/null 2>&1; then
    STAGED_SWIFT=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.swift$' || true)
    if [ -n "$STAGED_SWIFT" ]; then
        echo "🔍 SwiftLint nos arquivos staged…"
        echo "$STAGED_SWIFT" | xargs swiftlint lint --quiet --config .swiftlint.yml || {
            echo "❌ SwiftLint falhou. Rode 'make fix' e tente novamente."
            exit 1
        }
    fi
else
    echo "⚠️  swiftlint não encontrado — pulando."
fi

# 2. Audit de hardcoded colors (P0/P1 bloqueia)
if [ -f scripts/audit_dark_mode.py ]; then
    echo "🎨 Audit de cores hardcoded…"
    python3 scripts/audit_dark_mode.py --strict >/dev/null || {
        echo "❌ Cores hardcoded detectadas. Rode 'python3 scripts/audit_dark_mode.py' para detalhes."
        exit 1
    }
fi

echo "✅ Pre-commit OK"
